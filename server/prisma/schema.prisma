// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  SERVICE
  PHYSICAL
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  role           Role            @default(CUSTOMER)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  passwordResets PasswordReset[]

  @@index([email])
  @@index([role])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model Product {
  id          String             @id @default(uuid())
  name        String
  description String?
  type        ProductType        @default(SOFTWARE)
  salesPrice  Decimal            @db.Decimal(12, 2)
  costPrice   Decimal            @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  variants    ProductVariant[]
  plans       SubscriptionPlan[]
  discounts   Discount[]

  @@index([name])
  @@index([type])
  @@index([isActive])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  value           String
  additionalPrice Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

model SubscriptionPlan {
  id                     String           @id @default(uuid())
  name                   String
  description            String?
  productId              String
  product                Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  price                  Decimal          @db.Decimal(12, 2)
  billingFrequency       BillingFrequency @default(MONTHLY)
  billingInterval        Int              @default(1)
  minimumQuantity        Int              @default(1)
  availableFrom          DateTime
  availableUntil         DateTime?
  allowRenewal           Boolean          @default(true)
  allowPause             Boolean          @default(false)
  allowEarlyCancellation Boolean          @default(true)
  autoCloseOnExpiry      Boolean          @default(true)
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([productId])
  @@index([billingFrequency])
  @@index([isActive])
}

model Tax {
  id          String   @id @default(uuid())
  name        String
  rate        Decimal  @db.Decimal(5, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Discount {
  id                    String       @id @default(uuid())
  name                  String
  description           String?
  discountType          DiscountType @default(PERCENTAGE)
  discountValue         Decimal      @db.Decimal(12, 2)
  minimumPurchaseAmount Decimal?     @db.Decimal(12, 2)
  minimumQuantity       Int?
  startsAt              DateTime
  expiresAt             DateTime?
  usageLimit            Int?
  usedCount             Int          @default(0)
  isActive              Boolean      @default(true)
  appliesToAllProducts  Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  products              Product[]

  @@index([discountType])
  @@index([isActive])
}
